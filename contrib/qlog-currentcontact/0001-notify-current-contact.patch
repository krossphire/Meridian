+CurrentContactNotificationMsg::CurrentContactNotificationMsg(const QString &callsign,
+                                                             const QString &grid,
+                                                             double azimuth,
+                                                             QObject *parent) :
+    GenericNotificationMsg(parent)
+{
+    FCT_IDENTIFICATION;
+
+    QJsonObject data;
+    data["callsign"] = callsign.trimmed().toUpper();
+    data["grid"] = grid.trimmed().toUpper();
+    if ( qIsFinite(azimuth) )
+        data["azimuth"] = azimuth;
+
+    msg["msgtype"] = "currentcontact";
+    msg["data"] = data;
+}
